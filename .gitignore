# ==========================================
# ClinicalPrep AI Root Git Ignore Configuration
# Purpose: Prevents committing sensitive secrets, bulky dependencies,
#          build artifacts, and compiled runtime files to Git.
# ==========================================

# --- Virtual Environments ---
# Excludes local Python virtual environment folders containing binary packages
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# --- Environment Secrets & Credentials ---
# Prevents secret API keys (OPENAI_API_KEY, HF_TOKEN) from leaking to GitHub
.env
*.env
frontend/.env
frontend/.env.local
backend/.env

# --- Python Compiled & Cache Artifacts ---
# Excludes compiled CPython bytecode and testing cache directories
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.cache/

# --- Node.js Dependencies & Frontend Builds ---
# Excludes heavy node_modules packages and compiled React Vite output bundles
node_modules/
**/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.local

# --- Temporary Media & Runtime Files ---
# Excludes temporary WebM/MP3 audio recordings captured during local voice testing
*.webm
*.wav
*.mp3
tmp/

# --- IDE & System Metadata ---
# Excludes local editor settings, workspace files, and OS-generated metadata
.vscode/
.devcontainer/
*.code-workspace
.DS_Store
Thumbs.db